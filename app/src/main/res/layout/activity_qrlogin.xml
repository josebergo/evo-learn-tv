<?xml version="1.0" encoding="utf-8"?>
<!-- 扫码登录：二维码装进白色贴纸大卡 + 云朵星星装饰 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="56dp"
        android:layout_marginLeft="88dp"
        android:src="@drawable/deco_cloud"
        android:contentDescription="@null" />

    <ImageView
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="60dp"
        android:layout_marginRight="110dp"
        android:src="@drawable/deco_star"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="48dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_card"
            android:padding="24dp">

            <ImageView
                android:id="@+id/qr_image"
                android:layout_width="@dimen/qr_size"
                android:layout_height="@dimen/qr_size"
                android:background="@color/qr_bg"
                android:padding="16dp"
                android:contentDescription="@string/qr_title" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="64dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qr_title"
                android:textColor="@color/text_primary"
                android:textSize="42sp" />

            <TextView
                android:id="@+id/qr_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/qr_waiting"
                android:textColor="@color/card_c3"
                android:textSize="24sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/qr_hint"
                android:textColor="@color/text_secondary"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
