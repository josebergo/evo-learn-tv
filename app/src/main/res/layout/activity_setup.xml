<?xml version="1.0" encoding="utf-8"?>
<!-- 首次向导：太阳云朵装饰 + 白色贴纸卡表单 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="36dp"
        android:layout_marginRight="72dp"
        android:src="@drawable/deco_sun"
        android:contentDescription="@null" />

    <ImageView
        android:layout_width="130dp"
        android:layout_height="65dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="64dp"
        android:layout_marginLeft="72dp"
        android:src="@drawable/deco_cloud"
        android:contentDescription="@null" />

    <ImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="56dp"
        android:layout_marginLeft="96dp"
        android:src="@drawable/deco_star"
        android:contentDescription="@null" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="640dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_panel_card"
            android:layout_marginTop="56dp"
            android:layout_marginBottom="56dp"
            android:padding="56dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_title"
                android:textColor="@color/text_primary"
                android:textSize="46sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/setup_hint"
                android:textColor="@color/text_secondary"
                android:textSize="20sp"
                android:gravity="center" />

            <EditText
                android:id="@+id/setup_pin"
                android:layout_width="360dp"
                android:layout_height="64dp"
                android:layout_marginTop="36dp"
                android:background="@drawable/bg_search_input"
                android:paddingLeft="22dp"
                android:paddingRight="22dp"
                android:hint="@string/setup_pin"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:textSize="26sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <EditText
                android:id="@+id/setup_pin2"
                android:layout_width="360dp"
                android:layout_height="64dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_search_input"
                android:paddingLeft="22dp"
                android:paddingRight="22dp"
                android:hint="@string/setup_pin2"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:textSize="26sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <Button
                android:id="@+id/setup_save"
                style="@style/Widget.EvoKids.Button"
                android:layout_width="360dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="@string/setup_btn" />

            <TextView
                android:id="@+id/setup_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#E5484D"
                android:textSize="18sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
