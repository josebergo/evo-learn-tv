<?xml version="1.0" encoding="utf-8"?>
<!-- 贴纸卡片：糖果色底+蜡笔描边由 CardPresenter 动态生成；
     有封面时中间媒体层显示封面图（内缩4dp成相框感，圆角裁剪在代码里设 outline），
     底部压暗渐变 + 白字描边保证标题可读；白药丸徽章斜放。固定宽度供网格计算列宽 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/card_width"
    android:layout_height="@dimen/card_height"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- 封面媒体层：CardPresenter 按条目有无 cover 控制显隐 -->
    <FrameLayout
        android:id="@+id/card_media"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/card_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <View
            android:id="@+id/card_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card_scrim" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/card_padding"
        android:gravity="bottom">

        <TextView
            android:id="@+id/card_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_badge"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:rotation="-2"
            android:textColor="@color/crayon"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <com.evolearn.kidszone.ui.StrokeTextView
            android:id="@+id/card_title"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:textColor="@color/crayon"
            android:textSize="@dimen/card_title"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="bottom" />

        <com.evolearn.kidszone.ui.StrokeTextView
            android:id="@+id/card_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/crayon_soft"
            android:textSize="@dimen/card_sub"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
