<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="960dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="18dp"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/settings_section_account"
            android:textColor="@color/accent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setting_account_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btn_qr_login"
            style="@style/Widget.EvoKids.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_qr"
            android:text="@string/settings_login" />

        <Button
            android:id="@+id/btn_logout"
            style="@style/Widget.EvoKids.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_logout"
            android:text="@string/settings_logout" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/settings_section_config"
            android:textColor="@color/accent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setting_config_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btn_edit_config_url"
            style="@style/Widget.EvoKids.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_settings"
            android:text="@string/settings_edit_config_url" />

        <Button
            android:id="@+id/btn_reset_config"
            style="@style/Widget.EvoKids.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_refresh"
            android:text="@string/settings_reset_config" />

        <Button
            android:id="@+id/btn_reload_config"
            style="@style/Widget.EvoKids.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_refresh"
            android:text="@string/settings_reload" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/settings_section_security"
            android:textColor="@color/accent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_change_pin"
            style="@style/Widget.EvoKids.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_lock"
            android:text="@string/settings_change_pin" />

        <Button
            android:id="@+id/btn_exit_app"
            style="@style/Widget.EvoKids.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_power"
            android:text="@string/settings_exit" />
    </LinearLayout>
</ScrollView>
