<?xml version="1.0" encoding="utf-8"?>
<!-- 贴纸主按钮：芒果糖实底（确定/保存类），焦点提亮 + 橙描边加粗 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#FFD775" />
            <corners
                android:topLeftRadius="34dp"
                android:topRightRadius="26dp"
                android:bottomLeftRadius="30dp"
                android:bottomRightRadius="38dp" />
            <stroke android:width="5dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/card_c1" />
            <corners
                android:topLeftRadius="34dp"
                android:topRightRadius="26dp"
                android:bottomLeftRadius="30dp"
                android:bottomRightRadius="38dp" />
            <stroke android:width="3dp" android:color="@color/crayon" />
        </shape>
    </item>
</selector>
