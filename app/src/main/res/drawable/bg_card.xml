<?xml version="1.0" encoding="utf-8"?>
<!-- 贴纸卡片底（CardPresenter 会按糖果色动态生成覆盖版） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/bg_card_focused" />
            <corners
                android:topLeftRadius="30dp"
                android:topRightRadius="24dp"
                android:bottomLeftRadius="26dp"
                android:bottomRightRadius="34dp" />
            <stroke android:width="5dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/bg_card" />
            <corners
                android:topLeftRadius="30dp"
                android:topRightRadius="24dp"
                android:bottomLeftRadius="26dp"
                android:bottomRightRadius="34dp" />
            <stroke android:width="3dp" android:color="@color/crayon" />
        </shape>
    </item>
</selector>
