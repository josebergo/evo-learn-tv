<?xml version="1.0" encoding="utf-8"?>
<!-- 家长控制/刷新片源按钮：缝线贴纸风——外圈蜡笔虚线"针脚"，内嵌白底圆角贴纸；
     焦点态橙色实线+暖黄底 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FFF3D9" />
                    <corners android:radius="16dp" />
                    <stroke android:width="4dp" android:color="@color/accent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- 外圈：虚线针脚 -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/crayon"
                        android:dashWidth="7dp"
                        android:dashGap="5dp" />
                </shape>
            </item>
            <!-- 内嵌：白底贴纸 -->
            <item
                android:left="5dp"
                android:right="5dp"
                android:top="5dp"
                android:bottom="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/bg_panel" />
                    <corners android:radius="11dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
