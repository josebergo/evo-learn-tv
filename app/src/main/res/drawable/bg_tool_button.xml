<?xml version="1.0" encoding="utf-8"?>
<!-- 家长控制/刷新片源按钮：与分类条目同语言——常态白底蜡笔边，焦点黛紫底橙边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_c1" />
            <corners android:radius="14dp" />
            <stroke android:width="4dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_panel" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/crayon" />
        </shape>
    </item>
</selector>
